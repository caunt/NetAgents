<Project>
  <ItemGroup>
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <Using Include="Xunit" />
  </ItemGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NetAgents.Analyzers'">
    <NetAgentsSelfAnalysisAssemblyPath>$(MSBuildThisFileDirectory)artifacts/self-analysis/$(Configuration)/NetAgents.Analyzers.dll</NetAgentsSelfAnalysisAssemblyPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'NetAgents.Analyzers' and '$(NetAgentsSelfAnalysisBuild)' == 'true'">
    <Analyzer Include="$(NetAgentsSelfAnalysisAssemblyPath)" />
  </ItemGroup>
  <Target Name="AnalyzeNetAgentsSource" AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'NetAgents.Analyzers' and '$(NetAgentsSelfAnalysisBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(NetAgentsSelfAnalysisAssemblyPath)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Rebuild"
             Properties="NetAgentsSelfAnalysisBuild=true;VersionTimestamp=$(VersionTimestamp)" />
  </Target>
</Project>
