<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../src/NetAgents.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="../src/CodeFixes/NetAgents.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="../src/BuildTasks/NetAgents.BuildTasks.csproj" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildBinPath)/Microsoft.Build.Framework.dll" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildBinPath)/Microsoft.Build.Utilities.Core.dll" />
    <Compile Include="../src/BuildTasks/Formatter/Incremental/*.cs" Link="Infrastructure/Incremental/%(Filename)%(Extension)" />
    <Compile Include="../src/BuildTasks/Formatter/AnalyzerCatalog.cs" Link="Infrastructure/AnalyzerCatalog.cs" />
    <Compile Include="../src/BuildTasks/Formatter/AnalyzerLoader.cs" Link="Infrastructure/AnalyzerLoader.cs" />
    <Compile Include="../src/BuildTasks/Formatter/HostedAnalyzerReference.cs" Link="Infrastructure/HostedAnalyzerReference.cs" />
    <Compile Include="../src/BuildTasks/Formatter/CodeFixRunner.cs" Link="Infrastructure/CodeFixRunner.cs" />
    <Compile Include="../src/BuildTasks/Formatter/FormattingAnalysis.cs" Link="Infrastructure/FormattingAnalysis.cs" />
    <Compile Include="../src/BuildTasks/Formatter/FormattingProgress.cs" Link="Infrastructure/FormattingProgress.cs" />
    <Compile Include="../src/BuildTasks/Formatter/FormattingSyntax.cs" Link="Infrastructure/FormattingSyntax.cs" />
    <Compile Include="../src/BuildTasks/Formatter/CompositionParts.cs" Link="Infrastructure/CompositionParts.cs" />
    <Compile Include="../src/BuildTasks/Formatter/BuildDiagnostics.cs" Link="Infrastructure/BuildDiagnostics.cs" />
    <Compile Include="../src/BuildTasks/Formatter/LanguageVersionResolver.cs" Link="Infrastructure/LanguageVersionResolver.cs" />
    <Using Include="Xunit" />
    <!-- The formatter loads the code-style analyzers the building SDK supplies, so the tests need its path. -->
    <AssemblyMetadata Include="CodeStyleDirectory" Value="$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/codestyle/cs" />
  </ItemGroup>
</Project>
