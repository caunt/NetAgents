<Project>
  <UsingTask TaskName="NetAgents.BuildTasks.FormatProject" AssemblyFile="$(MSBuildThisFileDirectory)../tools/net10.0/NetAgents.BuildTasks.dll" />
  <Target Name="FormatNetAgentsConsumerSource" BeforeTargets="CoreCompile"
          DependsOnTargets="ValidateNetAgentsConsumerPolicy;_FormatNetAgentsSource"
          Condition="'$(DesignTimeBuild)' != 'true'" />
  <Target Name="_FormatNetAgentsSource">
    <ItemGroup>
      <NetAgentsFormattingAnalyzers Include="@(Analyzer)" />
      <NetAgentsFormattingBuildFiles Include="$(MSBuildProjectFullPath);$(MSBuildAllProjects);$(ProjectAssetsFile);$(CodeAnalysisRuleSet);$(AssemblyOriginatorKeyFile);@(CustomAdditionalCompileInputs)" />
      <FileWrites Include="$(IntermediateOutputPath)$(MSBuildProjectFile).NetAgents.formatting.cache" />
    </ItemGroup>
    <!-- MSBuild binds item lists only to array task parameters, so every list reaches the task as text: one line per item,
         its full path first, then a tab before each metadata value the formatter reads. -->
    <PropertyGroup>
      <_NetAgentsFormattingBuildProperties>TargetFramework=$(TargetFramework)%0AConfiguration=$(Configuration)%0APlatform=$(Platform)%0ARuntimeIdentifier=$(RuntimeIdentifier)%0ANETCoreSdkVersion=$(NETCoreSdkVersion)%0AMSBuildVersion=$(MSBuildVersion)%0ANullable=$(Nullable)%0ACheckForOverflowUnderflow=$(CheckForOverflowUnderflow)%0AOptimize=$(Optimize)%0ADebugType=$(DebugType)%0AFeatures=$(Features)%0AWarningLevel=$(WarningLevel)%0ANoWarn=$(NoWarn)%0AWarningsAsErrors=$(WarningsAsErrors)%0AWarningsNotAsErrors=$(WarningsNotAsErrors)%0ATreatWarningsAsErrors=$(TreatWarningsAsErrors)%0AAnalysisLevel=$(AnalysisLevel)%0AAnalysisMode=$(AnalysisMode)%0AAnalysisLevelStyle=$(AnalysisLevelStyle)%0AAnalysisModeStyle=$(AnalysisModeStyle)%0AGenerateDocumentationFile=$(GenerateDocumentationFile)%0ADocumentationFile=$(DocumentationFile)%0ADeterministic=$(Deterministic)%0APathMap=$(PathMap)%0ACscToolPath=$(CscToolPath)%0ACscToolExe=$(CscToolExe)</_NetAgentsFormattingBuildProperties>
    </PropertyGroup>
    <NetAgents.BuildTasks.FormatProject ProjectPath="$(MSBuildProjectFullPath)"
                                       AssemblyName="$(AssemblyName)"
                                       RootNamespace="$(RootNamespace)"
                                       LanguageVersion="$(LangVersion)"
                                       DefineConstants="$(DefineConstants)"
                                       AllowUnsafe="$(AllowUnsafeBlocks)"
                                       OutputType="$(OutputType)"
                                       SourceFiles="@(Compile->'%(FullPath)%09%(Link)', '%0A')"
                                       References="@(ReferencePathWithRefAssemblies->'%(FullPath)%09%(Aliases)%09%(EmbedInteropTypes)', '%0A')"
                                       AnalyzerFiles="@(NetAgentsFormattingAnalyzers->'%(FullPath)', '%0A')"
                                       AdditionalFiles="@(AdditionalFiles->'%(FullPath)', '%0A')"
                                       ConfigurationFiles="@(EditorConfigFiles->'%(FullPath)', '%0A')"
                                       CacheFile="$(IntermediateOutputPath)$(MSBuildProjectFile).NetAgents.formatting.cache"
                                       BuildFiles="@(NetAgentsFormattingBuildFiles->'%(FullPath)', '%0A')"
                                       BuildProperties="$(_NetAgentsFormattingBuildProperties)"
                                       CodeFixDirectory="$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/codestyle/cs"
                                       SdkAssemblyDirectory="$(MSBuildToolsPath)/DotnetTools/dotnet-format" />
  </Target>
  <ItemGroup>
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)NetAgents.globalconfig" />
  </ItemGroup>
  <Target Name="ValidateNetAgentsConsumerPolicy" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Code="NETAGENTS0014" Condition="'$(Nullable)' != 'enable'"
           Text="NetAgents.Analyzers requires Nullable=enable. Remove the conflicting project setting." />
    <Error Code="NETAGENTS0014" Condition="'$(TreatWarningsAsErrors)' != 'true' or '$(CodeAnalysisTreatWarningsAsErrors)' != 'true' or '$(EffectiveCodeAnalysisTreatWarningsAsErrors)' == 'false'"
           Text="NetAgents.Analyzers requires TreatWarningsAsErrors=true and CodeAnalysisTreatWarningsAsErrors=true. Remove the conflicting project setting." />
    <Error Code="NETAGENTS0014" Condition="'$(EnableNETAnalyzers)' != 'true' or '$(EnforceCodeStyleInBuild)' != 'true' or '$(RunAnalyzersDuringBuild)' != 'true' or '$(RunAnalyzers)' != 'true' or '$(SkipGlobalAnalyzerConfigForPackage)' == 'true'"
           Text="NetAgents.Analyzers requires compiler, style, and build analyzers to remain enabled." />
    <Error Code="NETAGENTS0014" Condition="'$(AnalysisLevel)' != 'latest-all' or ('$(AnalysisMode)' != 'All' and '$(AnalysisMode)' != 'AllEnabledByDefault')"
           Text="NetAgents.Analyzers requires AnalysisLevel=latest-all and AnalysisMode=All." />
    <Error Code="NETAGENTS0014" Condition="'$(AnalysisLevelStyle)' != 'latest-all' or ('$(AnalysisModeStyle)' != 'All' and '$(AnalysisModeStyle)' != 'AllEnabledByDefault') or '$(EnableCodeStyleSeverity)' != 'true'"
           Text="NetAgents.Analyzers requires AnalysisLevelStyle=latest-all, AnalysisModeStyle=AllEnabledByDefault, and EnableCodeStyleSeverity=true." />
    <Error Code="NETAGENTS0014" Condition="'$(GenerateDocumentationFile)' != 'true' or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(WarningsAsErrors)', '(?i)(^|[\s,;])(?:CS)?1591($|[\s,;])'))"
           Text="NetAgents.Analyzers requires GenerateDocumentationFile=true and CS1591 in WarningsAsErrors. Document every public API." />
    <Error Code="NETAGENTS0014" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(NoWarn);$(WarningsNotAsErrors)', '(?i)(^|[\s,;])(?:NETAGENTS[0-9]+|IDE[0-9]+|CA[0-9]+|(?:CS)?1591)($|[\s,;])'))"
           Text="NetAgents.Analyzers, .NET analyzer, style, and public documentation diagnostics cannot be suppressed through NoWarn or WarningsNotAsErrors." />
  </Target>
</Project>
